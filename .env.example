# Copy to .env and fill in your Razorpay TEST MODE credentials.
# Get them from: https://dashboard.razorpay.com/app/keys (Test Mode)

# Razorpay public key id (safe to expose to the browser)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# Razorpay key secret (server-side only — never expose or commit)
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay webhook secret — must match Dashboard → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
